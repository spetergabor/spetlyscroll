{
  "name": "spetlyscroll",
  "version": "1.0.0",
  "description": "A private desktop carousel studio for seamless social posts.",
  "main": "electron/main.cjs",
  "author": "spetergabor",
  "license": "MIT",
  "scripts": {
    "desktop": "electron .",
    "desktop:icon": "node electron/create-icon.mjs",
    "desktop:build": "npm run desktop:icon && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "com.spetergabor.spetlyscroll",
    "productName": "Spetlyscroll",
    "asar": true,
    "directories": {
      "output": "outputs/desktop",
      "buildResources": "assets/desktop"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "assets/desktop/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    },
    "dmg": {
      "title": "Spetlyscroll ${version}",
      "sign": false
    },
    "artifactName": "Spetlyscroll-${version}-${arch}.${ext}"
  }
}
